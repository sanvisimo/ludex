  {
   "id": "e20",
   "type": "text",
   "x": 28,
   "y": 400,
   "width": 495.00000000000006,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
