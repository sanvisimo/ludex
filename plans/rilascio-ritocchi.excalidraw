1793300000000, "link": null, "locked": false, "index": "a0071", "type": "text", "id": "t72", "x": 60, "y": 1527.0, "text": "Conferma l’indirizzo", "originalText": "Conferma l’indirizzo", "fontSize": 16, "width": 176.0, "height": 20.0, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"angle": 0, "strokeColor": "#757575", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1203533129, "version": 1, "versionNonce": 912252119, "isDeleted": false, "boundElements": [], "updated": 1793300000000, "link": null, "locked": false, "index": "a0072", "type": "text", "id": "t73", "x": 50, "y": 1575, "text": "Il link è valido per un’ora.", "originalText": "Il link è valido per un’ora.", "fontSize": 15, "width": 231.00000000000003, "height": 18.75, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"angle": 0, "strokeColor": "#757575", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 876082604, "version": 1, "versionNonce": 71188214, "isDeleted": false, "boundElements": [], "updated": 1793300000000, "link": null, "locked": false, "index": "a0073", "type": "text", "id": "t74", "x": 50, "y": 1600, "text": "Se il bottone non funziona, copia\nquesto indirizzo nel browser:\nhttps://ludex…/verify-email?token=…", "originalText": "Se il bottone non funziona, copia\nquesto indirizzo nel browser:\nhttps://ludex…/verify-email?token=…", "fontSize": 14, "width": 269.5, "height": 52.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"angle": 0, "strokeColor": "#757575", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 297015553, "version": 1, "versionNonce": 1156179110, "isDeleted": false, "boundElements": [], "updated": 1793300000000, "link": null, "locked": false, "index": "a0074", "type": "text", "id": "t75", "x": 50, "y": 1665, "text": "Se non hai richiesto la registrazione,\npuoi ignorare questa email.", "originalText": "Se non hai richiesto la registrazione,\npuoi ignorare questa email.", "fontSize": 14, "width": 292.6, "height": 35.0, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"angle": 0, "strokeColor": "#757575", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1767063625, "version": 1, "versionNonce": 1914290651, "isDeleted": false, "boundElements": [], "updated": 1793300000000, "link": null, "locked": false, "index": "a0075", "type": "text", "id": "t76", "x": 50, "y": 1712, "text": "Ludex · ludex.sanvisimo.tech", "originalText": "Ludex · ludex.sanvisimo.tech", "fontSize": 14, "width": 215.60000000000002, "height": 17.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"angle": 0, "strokeColor": "#757575", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1069721865, "version": 1, "versionNonce": 259654724, "isDeleted": false, "boundElements": [], "updated": 1793300000000, "link": null, "locked": false, "index": "a0076", "type": "text", "id": "t77", "x": 530, "y": 1330, "text": "Una colonna, larga al massimo 560 px.\nSolo testo e un bottone: niente\nimmagini da caricare, quindi niente\n«mostra immagini» e niente pixel\ndi tracciamento. Il logo è il nome\nin testo col colore dell’app.\nStessa struttura per tutte e sei.", "originalText": "Una colonna, larga al massimo 560 px.\nSolo testo e un bottone: niente\nimmagini da caricare, quindi niente\n«mostra immagini» e niente pixel\ndi tracciamento. Il logo è il nome\nin testo col colore dell’app.\nStessa struttura per tutte e sei.", "fontSize": 15, "width": 305.25, "height": 131.25, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}