   "id": "t117",
   "x": 1610,
   "y": 1014,
   "text": "×",
   "fontSize": 22,
   "width": 12.32,
   "height": 27.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "×",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1010406556,
   "version": 3,
   "versionNonce": 211756506,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791203068575,
   "link": null,
   "locked": false,
   "index": "a0118",
   "created": null,
   "type": "text",
   "id": "t118",
   "x": 1140,
   "y": 1060,
   "text": "L'account Steam e i tuoi giochi restano, e l'import\ncontinua dal profilo pubblico.\n\nLe copie della famiglia escono dalla libreria, tranne\nquelle su cui hai messo un voto, note o tag.\nPotrai rifare il login quando vuoi.",
   "fontSize": 14,
   "width": 415.52000000000004,
   "height": 105.0,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "L'account Steam e i tuoi giochi restano, e l'import\ncontinua dal profilo pubblico.\n\nLe copie della famiglia escono dalla libreria, tranne\nquelle su cui hai messo un voto, note o tag.\nPotrai rifare il login quando vuoi.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "angle": 0,
