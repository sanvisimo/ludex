.vercel

# Build Outputs
.next/
out/
build
dist

# Output di un `tsc` lanciato a mano su un singolo file: ignora il tsconfig e
# scrive il .js accanto al .ts. Gli unici .js legittimi stanno a radice di
# package (le config di eslint, next, postcss) e queste righe non li toccano.
apps/*/src/**/*.js
apps/*/test/**/*.js
packages/*/src/**/*.js

#IDE
.idea/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
