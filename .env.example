# Copiare in .env alla radice del repo. Tutti i workspace leggono da qui.

DATABASE_URL=postgresql://ludex:ludex@localhost:5433/ludex
# Database dei test: separato, le tabelle vengono troncate a ogni caso.
# Lo crea e lo migra il global setup di vitest, non serve farlo a mano.
TEST_DATABASE_URL=postgresql://ludex:ludex@localhost:5433/ludex_test

# openssl rand -base64 32
BETTER_AUTH_SECRET=cambiami
BETTER_AUTH_URL=http://localhost:3001

WEB_URL=http://localhost:3000
API_PORT=3001

NEXT_PUBLIC_API_URL=http://localhost:3001

# Coda BullMQ
REDIS_URL=redis://localhost:6379

IGDB_CLIENT_ID=igdb_client_id
IGDB_CLIENT_SECRET=igdb_client_secret
STEAMGRIDDB_API_KEY=steamgriddb_api_key

# Chiave dell'applicazione: identifica noi, non l'utente. Per leggere una
# libreria basta che quel profilo Steam sia pubblico.
STEAM_API_KEY=
# SteamID64 di prova, usato solo dallo script `steam:probe`. I test non escono
# in rete: stubbano al confine del modulo.
STEAM_TEST_USER_ID=

# npsso di prova, usato solo dallo script `psn:probe`. Si prende entrando su
# playstation.com e aprendo poi https://ca.account.sony.com/api/v1/ssocookie:
# va bene il JSON intero o il solo valore. Dura poco — è un cookie di sessione —
# e non serve al server, che dall'npsso ricava subito i token veri.
PSN_TEST_NPSSO=

# HowLongToBeat non ha un'API pubblica e ogni tanto cambia il path di quella che
# usa il suo sito (era /api/find, oggi /api/bleed). Quando succede tutti i job
# HLTB rispondono 404: si rimette qui il path nuovo, senza toccare il codice.
# Vuota = si usa il default scritto in apps/api/src/external/hltb.ts.
HLTB_API_PATH=

# OpenCritic passa da RapidAPI: l'accesso anonimo alla loro API non esiste più.
# Il piano gratuito dà due budget separati che si azzerano ogni 24 ore — 200
# richieste e 25 ricerche — e la risposta li dichiara a ogni chiamata. Le
# ricerche sono la risorsa scarsa, e per questo l'identità dei giochi si prende
# da Wikidata: agganciare per nome un'intera libreria le brucerebbe per giorni.
# Si registra su rapidapi.com/opencritic-opencritic-default/api/opencritic-api
OPENCRITIC_API_KEY=

# Metacritic non ha un'API pubblica: si passa dall'endpoint che usa il loro
# sito, la cui chiave è una costante scritta nel loro JavaScript. Non è un
# segreto e sta già nel codice; questa variabile serve solo il giorno in cui la
# ruotano — le risposte diventano 401 e si rimette qui la nuova.
METACRITIC_API_KEY=

# Cifra i credenziali dei negozi in `store_accounts.credentials` (step 9a):
# GOG, Epic e Amazon danno un refresh token per utente, e chi lo legge legge la
# libreria di quella persona. La chiave sta qui e non nel database, così un dump
# da solo non basta. **32 byte esatti in base64**, o l'API si rifiuta di partire:
# openssl rand -base64 32
#
# Cambiarla rende illeggibili i credenziali già salvati: gli utenti si ritrovano
# in `needs_reauth` e devono ricollegare gli account.
STORE_TOKEN_KEY=

# Dashboard Bull Board (`pnpm --filter api queues`). Ascolta solo su localhost:
# è un arnese da operatore, non una pagina dell'app.
BULL_BOARD_PORT=3002
