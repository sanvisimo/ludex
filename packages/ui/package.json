{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./palettes": "./src/palettes.ts",
    "./icons": "./src/icons.ts"
  },
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "icons:add": "sh -c 'tamagui icons add --out src/lucide \"$@\" && prettier --write src/lucide' --",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "chromatic": "dotenv -e ../../.env -- chromatic",
    "brand:email": "node scripts/generate-email-brand.mjs"
  },
  "dependencies": {
    "@tamagui/colors": "^3.3.3",
    "@tamagui/config": "^3.3.3",
    "@tamagui/core": "^3.3.3",
    "@tamagui/get-font-sized": "3.3.3",
    "@tamagui/helpers-icon": "3.3.3",
    "@tamagui/toast": "3.3.3",
    "@tamagui/web": "^3.3.3",
    "tamagui": "^3.3.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": "*",
    "react-native-svg": "*",
    "react-native-web": "*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-native/assets-registry": "0.88.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-native-web-vite": "^10.6.0",
    "@tamagui/cli": "3.3.3",
    "@tamagui/react-native-svg": "^3.3.3",
    "@tamagui/vite-plugin": "^3.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "chromatic": "^18.9.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.15.0",
    "playwright": "^1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0",
    "storybook": "^10.6.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  }
