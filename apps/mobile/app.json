{
  "expo": {
    "name": "PileCue",
    "slug": "ludex",
    "version": "0.1.0",
    "scheme": "pilecue",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#101426",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#101426"
          }
        }
      ],
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-status-bar",
      "./plugins/with-release-signing"
    ],
    "ios": {
      "bundleIdentifier": "com.pilecue.app"
    },
    "android": {
      "package": "com.pilecue.app",
      "versionCode": 1
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b29c8334-e7ac-4ff3-8216-c990cb3596c6"
      }
    },
    "owner": "pilecue"
  }
}
