{
  "expo": {
    "name": "PileCue",
    "slug": "ludex",
    "scheme": "pilecue",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#101426",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#101426"
          }
        }
      ],
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "ios": {
      "bundleIdentifier": "com.pilecue.app"
    },
    "android": {
      "package": "com.pilecue.app"
    }
  }
}
